# ─── Referencia de variables para Fly.io ─────────────────────────────────────
# Configura los SECRETOS con:  fly secrets set VARIABLE=valor  (desde cada carpeta)
# Las variables no sensibles ya están en fly.toml bajo [env]

# ── Eureka (URL interna de Fly.io) ───────────────────────────────────────────
# En Fly.io la red interna usa el formato: <app-name>.internal
# El puerto lo expone Fly internamente en el 8761
EUREKA_URL=http://relatos-eureka.internal:8761/eureka/

# ── OpenSearch / Bonsai (para catalogue) ─────────────────────────────────────
OPENSEARCH_HOST=luminous-hornbeam-1mfw0psh.us-east-1.bonsaisearch.net
OPENSEARCH_USERNAME=tu_usuario_bonsai
OPENSEARCH_PASSWORD=tu_password_bonsai

# ── MySQL (para payments) ─────────────────────────────────────────────────────
# Fly.io tiene su propio managed MySQL o puedes usar PlanetScale (gratuito)
# Los valores los obtienes al crear la base de datos
DB_HOST=tu-mysql-host.fly.dev
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
PAYMENTS_DB_NAME=payments_db

# ── CORS (para api-gateway) ───────────────────────────────────────────────────
FRONTEND_URL=https://tu-proyecto.vercel.app
# VERCEL_CUSTOM_DOMAIN=https://mi-dominio.com  (opcional)
