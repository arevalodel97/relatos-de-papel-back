# ─── Copia este archivo como referencia para configurar las variables
# ─── en el dashboard de Railway. NUNCA subas el .env real.

# ── Eureka ──────────────────────────────────────────────────────────────────
# En Railway, la URL interna del eureka será:
# http://<nombre-servicio-eureka>.railway.internal:8761/eureka/
EUREKA_URL=http://eureka.railway.internal:8761/eureka/
EUREKA_ENABLED=true

# ── Base de datos (MySQL plugin de Railway) ──────────────────────────────────
# Railway inyecta estas variables automáticamente cuando añades el plugin MySQL:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# Mapéalas a las que usa tu app:
DB_HOST=MYSQLHOST        # copiar el valor que da Railway
DB_PORT=3306
DB_USERNAME=MYSQLUSER    # copiar el valor que da Railway
DB_PASSWORD=MYSQLPASSWORD
PAYMENTS_DB_NAME=railway

# ── Nombres de servicio (para eureka load balancer) ──────────────────────────
CATALOGUE_SERVICE_NAME=ms-books-catalogue
PAYMENTS_SERVICE_NAME=ms-books-payments

# ── Puertos (Railway gestiona el puerto con $PORT automáticamente) ───────────
# No es necesario configurar SERVER_PORT; Railway usa la var PORT

# ── OpenSearch / Bonsai (igual que en local) ─────────────────────────────────
OPENSEARCH_HOST=luminous-hornbeam-1mfw0psh.us-east-1.bonsaisearch.net
OPENSEARCH_PORT=443
OPENSEARCH_SCHEME=https
OPENSEARCH_USERNAME=tu_usuario_bonsai
OPENSEARCH_PASSWORD=tu_password_bonsai
OPENSEARCH_INDEX=books

# ── CORS (URL pública del frontend) ──────────────────────────────────────────
# Pon aquí la URL de tu frontend desplegado (Vercel, Netlify, etc.)
FRONTEND_URL=https://tu-frontend.vercel.app
