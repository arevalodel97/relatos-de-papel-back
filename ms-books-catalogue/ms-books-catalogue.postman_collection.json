{
  "info": {
    "name": "ms-books-catalogue - Colección Completa",
    "_postman_id": "ms-books-catalogue-full-v2",
    "description": "Colección completa para validar todos los endpoints del microservicio de catálogo de libros con OpenSearch y paginación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081", "type": "string" },
    { "key": "createdBookId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "── GET /books ──────────────────────────",
      "item": [
        {
          "name": "01 - Listar todos (sin filtros, página 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene books, facets y paginación', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('books');",
                  "  pm.expect(b).to.have.property('facets');",
                  "  pm.expect(b).to.have.property('totalElements');",
                  "  pm.expect(b).to.have.property('totalPages');",
                  "  pm.expect(b).to.have.property('currentPage');",
                  "  pm.expect(b).to.have.property('pageSize');",
                  "});",
                  "pm.test('books tiene máximo 10 elementos', () => {",
                  "  pm.expect(pm.response.json().books.length).to.be.at.most(10);",
                  "});",
                  "pm.test('currentPage es 0 y pageSize es 10', () => {",
                  "  pm.expect(pm.response.json().currentPage).to.equal(0);",
                  "  pm.expect(pm.response.json().pageSize).to.equal(10);",
                  "});",
                  "pm.test('Todos los libros son visible=true', () => {",
                  "  pm.response.json().books.forEach(b => pm.expect(b.visible).to.be.true);",
                  "});",
                  "pm.test('Cada libro tiene los campos del mapping', () => {",
                  "  const book = pm.response.json().books[0];",
                  "  ['id','title','author','isbn','pages','rating','category','stock','visible','publication_date','price','photo']",
                  "    .forEach(f => pm.expect(book).to.have.property(f));",
                  "});",
                  "pm.test('Facets tiene categories, ratings, priceRange y booksWithStock', () => {",
                  "  const f = pm.response.json().facets;",
                  "  pm.expect(f).to.have.all.keys('categories','ratings','priceRange','booksWithStock');",
                  "});",
                  "pm.test('totalElements refleja el total real (no solo la página)', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.totalElements).to.be.at.least(body.books.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/books?page=0&size=10",
              "host": ["{{baseUrl}}"], "path": ["books"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
