                  "  pm.expect(b.price).to.equal(19.99);",
                  "  pm.expect(b.visible).to.be.true;",
                  "  pm.collectionVariables.set('createdBookId', b.id);",
                  "  console.log('ID creado y guardado:', b.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
