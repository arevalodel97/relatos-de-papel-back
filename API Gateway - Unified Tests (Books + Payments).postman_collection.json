  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "Setup - Generar ISBN y datos únicos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generar ISBN-13 válido con guiones",
                  "const ts12 = Date.now().toString().slice(-12);",
                  "const base12 = ts12.padStart(12, '0');",
                  "let sum = 0;",
                  "for (let i = 0; i < 12; i++) {",
                  "  const d = parseInt(base12.charAt(i), 10);",
                  "  sum += d * (i % 2 === 0 ? 1 : 3);",
                  "}",
                  "const check = (10 - (sum % 10)) % 10;",
                  "const isbn13 = base12 + check;",
                  "const formatted = isbn13.substring(0,3) + '-' + isbn13.charAt(3) + '-' + isbn13.substring(4,7) + '-' + isbn13.substring(7,12) + '-' + isbn13.charAt(12);",
                  "",
                  "pm.environment.set('uniqueIsbn', isbn13);",
                  "pm.environment.set('uniqueIsbnFormatted', formatted);",
                  "pm.environment.set('uniqueTitle', 'Libro Gateway ' + Date.now());",
                  "pm.environment.set('customerName', 'Cliente Test ' + Date.now());",
                  "pm.environment.set('customerEmail', 'test' + Date.now() + '@example.com');",
                  "",
                  "console.log('✅ Variables generadas:');",
                  "console.log('ISBN:', formatted);",
                  "console.log('Título:', pm.environment.get('uniqueTitle'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Variables configuradas correctamente', () => {",
                  "  pm.expect(pm.environment.get('uniqueIsbnFormatted')).to.be.a('string');",
                  "  pm.expect(pm.environment.get('uniqueTitle')).to.be.a('string');",
                  "  pm.expect(pm.environment.get('customerName')).to.be.a('string');",
                  "  pm.expect(pm.environment.get('customerEmail')).to.match(/^.+@.+\\..+$/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"GET\",\n  \"queryParams\": {\n    \"path\": \"/books\"\n  }\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/gateway",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "gateway"
              ]
            }
          },
          "response": []
        }
      ]
